# Servidor
PORT=3002
LOG_LEVEL=info

# Nvidia NIM (OpenAI-compatible). Si NVIDIA_API_KEY está vacío, se usa el motor mock.
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_MODEL=meta/llama-3.1-70b-instruct
NIM_TIMEOUT_MS=20000

# Link al catálogo público que el bot comparte
CATALOG_URL=http://localhost:3000

# Límite de consultas por teléfono por minuto
RATE_LIMIT_PER_PHONE=10
